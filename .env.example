DATABASE_URL=postgres://postgres:postgres@localhost:7889/context_still
# Local-first SQLite mode. Enable these to run register/search/context_compile against SQLite
# without requiring PostgreSQL for the primary knowledge/compile path.
# CONTEXT_STILL_DB_BACKEND=sqlite
# CONTEXT_STILL_SQLITE_CORE_PATH=./data/context-still-core.sqlite
# Per-process PostgreSQL pool settings. Hono, MCP, and queue workers each get their own pool.
# Keep the sum of long-lived process pool max values below PostgreSQL max_connections.
CONTEXT_STILL_DB_POOL_MAX=3
CONTEXT_STILL_DB_POOL_IDLE_TIMEOUT_MS=10000
CONTEXT_STILL_DB_POOL_CONNECTION_TIMEOUT_MS=5000
CONTEXT_STILL_SECURITY_INTELLIGENCE_CANDIDATE_ENABLED=false
CONTEXT_STILL_SECURITY_INTELLIGENCE_CANDIDATE_TOKEN=
CONTEXT_STILL_SECURITY_INTELLIGENCE_FEEDBACK_ENABLED=false
CONTEXT_STILL_SECURITY_INTELLIGENCE_FEEDBACK_TOKEN=
CONTEXT_STILL_SECURITY_INTELLIGENCE_PRODUCER_PRINCIPAL=nightworkers:local-integration
CONTEXT_STILL_SECURITY_INTELLIGENCE_RATE_LIMIT_PER_MINUTE=120
CONTEXT_STILL_SECURITY_INTELLIGENCE_REQUEST_TIMEOUT_MS=15000
CONTEXT_STILL_API_HOST=127.0.0.1
# Required (minimum 32 characters) except for /api/health*. Generate with: openssl rand -hex 32
CONTEXT_STILL_ADMIN_API_KEY=
# Exact trusted browser origins. Direct same-origin UI sessions do not need this; TLS-terminating
# reverse proxies must list the external UI origin. When unset, cross-origin requests are disabled.
# CONTEXT_STILL_ALLOWED_ORIGINS=http://127.0.0.1:5173
# External bind requires both flags and a TLS reverse proxy.
CONTEXT_STILL_EXTERNAL_BIND_ALLOWED=0
CONTEXT_STILL_TLS_REVERSE_PROXY_CONFIRMED=0
CONTEXT_STILL_LANG=ja
# MCP v2 tool surface (default on). Set to 0/false to expose legacy v1 surface.
# CONTEXT_STILL_MCP_V2=1

# Distillation search provider order (kept intentionally)
CONTEXT_STILL_DISTILLATION_SEARCH_PROVIDERS=brave,exa
# Distillation LLM provider: local-llm | azure-openai | bedrock | auto
CONTEXT_STILL_DISTILLATION_PROVIDER=local-llm
# Maximum bytes accepted from fetch_content before the response is aborted (1 KiB–16 MiB).
CONTEXT_STILL_FETCH_MAX_RESPONSE_BYTES=2097152
# Optional findCandidate-only override. Unset inherits CONTEXT_STILL_DISTILLATION_PROVIDER.
# CONTEXT_STILL_DISTILLATION_FIND_CANDIDATE_PROVIDER=azure-openai
# Keep findCandidate lane always active without schedule waits (default: 1).
# Set 0 to restore interactive-pressure/cooldown based waiting.
# CONTEXT_STILL_FIND_CANDIDATE_NO_WAIT=1
# Busy-loop interval for successful queue worker runs. Defaults are 10 seconds.
# CONTEXT_STILL_FINDING_QUEUE_TASK_INTERVAL_SECONDS=10
# CONTEXT_STILL_COVERING_QUEUE_TASK_INTERVAL_SECONDS=10

# Azure OpenAI (Agentic Compile / Distillation)
CONTEXT_STILL_AZURE_OPENAI_API_KEY=
CONTEXT_STILL_AZURE_OPENAI_API_BASE_URL=https://your-resource.openai.azure.com

# AWS Bedrock (Agentic Compile / Distillation)
CONTEXT_STILL_BEDROCK_REGION=us-east-1
CONTEXT_STILL_BEDROCK_PROFILE=

# External Search
BRAVE_SEARCH_API_KEY=
CONTEXT_STILL_EXA_API_KEY=
EXA_API_KEY=

# Local LLM endpoint/secret
CONTEXT_STILL_LOCAL_LLM_API_BASE_URL=http://127.0.0.1:44448
CONTEXT_STILL_LOCAL_LLM_API_KEY=

# Embedding daemon endpoint/secret
CONTEXT_STILL_EMBEDDING_PROVIDER=auto
CONTEXT_STILL_EMBEDDING_DAEMON_URL=http://127.0.0.1:44512
CONTEXT_STILL_EMBEDDING_ACCESS_TOKEN=
# Rust resident starts and supervises the local e5embed runtime when provider is auto/daemon.
CONTEXT_STILL_RESIDENT_EMBEDDING=1
# Optional local runtime overrides:
# CONTEXT_STILL_LOCAL_LLM_EMBEDDING_ROOT=/path/to/local-llm/embedding
# CONTEXT_STILL_LOCAL_LLM_EMBEDDING_PYTHON=/path/to/local-llm/embedding/.venv/bin/python
# CONTEXT_STILL_LOCAL_LLM_EMBEDDING_MODEL_DIR=/path/to/multilingual-e5-small
# CONTEXT_STILL_EMBEDDING_READY_TIMEOUT_MS=60000

# Optional machine-local path overrides
# CONTEXT_STILL_CODEX_SESSION_DIR=/Users/your-user/.codex/sessions
# CONTEXT_STILL_CODEX_ARCHIVED_SESSION_DIR=/Users/your-user/.codex/archived_sessions
# CONTEXT_STILL_ANTIGRAVITY_LOG_DIR=/Users/your-user/.gemini/antigravity/brain
# CONTEXT_STILL_CODEX_SESSION_DIRS=/path/to/sessions1,/path/to/sessions2
# CONTEXT_STILL_CODEX_ARCHIVED_SESSION_DIRS=/path/to/archived1,/path/to/archived2
# CONTEXT_STILL_ANTIGRAVITY_LOG_DIRS=/path/to/brain1,/path/to/brain2
# Agent log chunks at or below this character count are not saved for distillation.
# CONTEXT_STILL_AGENT_LOG_MIN_DISTILLABLE_CHARS=2000

# Distillation conveyor LaunchAgent options
# CONTEXT_STILL_DISTILL_PIPELINE_INTERVAL_SECONDS=120
# CONTEXT_STILL_DISTILL_PIPELINE_KIND=auto
# CONTEXT_STILL_DISTILL_PIPELINE_LIMIT=1
# CONTEXT_STILL_DISTILL_PIPELINE_REFRESH=1
# CONTEXT_STILL_DISTILL_PIPELINE_PROVIDER=
# Set 0 to force single-provider mode when CONTEXT_STILL_DISTILL_PIPELINE_PROVIDER is set.
# Default (unset/1) keeps route fallback enabled.
# CONTEXT_STILL_DISTILL_PIPELINE_PROVIDER_FALLBACK=1
# CONTEXT_STILL_DISTILL_PIPELINE_VERSION=select-distillation-target-v1
