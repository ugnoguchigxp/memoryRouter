{
  "version": "finding-selector-v2",
  "signals": {
    "persistentPreference": {
      "durabilityTerms": ["今後", "以後", "毎回", "常に", "必ず", "禁止", "always", "never", "must", "do not"],
      "requires": ["userRole", "concreteSubjectAndAction"]
    },
    "causalResolution": {
      "requires": ["cause", "fix", "verification"]
    },
    "substantiveDiff": {
      "requires": ["agentDiff", "nonBoilerplateContent"]
    },
    "repeatableOperation": {
      "requires": ["operation", "verification"]
    }
  },
  "hardRejectReasonCodes": [
    "empty_content",
    "boilerplate_heavy",
    "progress_only",
    "build_succeeded_only"
  ],
  "uncertainLimit": {
    "fraction": 0.1,
    "maximumPerRun": 5
  }
}
