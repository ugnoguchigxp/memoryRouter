{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Compile evidence selector v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "decisions",
    "orderedOptionalIds"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "decisions": {
      "type": "array",
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidateId",
          "verdict",
          "reasonCode",
          "goalAnchors",
          "evidenceGroupIds"
        ],
        "properties": {
          "candidateId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "verdict": {
            "enum": [
              "include",
              "conditional",
              "omit"
            ]
          },
          "reasonCode": {
            "enum": [
              "direct",
              "prerequisite",
              "conflict",
              "precedent",
              "unrelated",
              "insufficient_evidence"
            ]
          },
          "goalAnchors": {
            "type": "array",
            "maxItems": 3,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          },
          "evidenceGroupIds": {
            "type": "array",
            "maxItems": 8,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "verdict": {
                  "const": "omit"
                }
              }
            },
            "then": {
              "properties": {
                "goalAnchors": {
                  "maxItems": 0
                },
                "evidenceGroupIds": {
                  "maxItems": 0
                },
                "reasonCode": {
                  "enum": [
                    "unrelated",
                    "insufficient_evidence"
                  ]
                }
              }
            },
            "else": {
              "properties": {
                "goalAnchors": {
                  "minItems": 1
                },
                "evidenceGroupIds": {
                  "minItems": 1
                },
                "reasonCode": {
                  "enum": [
                    "direct",
                    "prerequisite",
                    "conflict",
                    "precedent"
                  ]
                }
              }
            }
          }
        ]
      }
    },
    "orderedOptionalIds": {
      "type": "array",
      "maxItems": 24,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    }
  }
}
